# ==============================================================================
# Alpaca AI Trading Hackathon Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Alpaca Account Selection & Credentials
# ------------------------------------------------------------------------------
# Active account to use: 'test' (weekend prototyping) or 'competition' (official $100k)
ACTIVE_ACCOUNT=test

# Testing Paper Account Credentials (for local development & dry runs)
ALPACA_TEST_API_KEY=your_test_paper_key_here
ALPACA_TEST_SECRET_KEY=your_test_paper_secret_here

# Official Competition Paper Account Credentials ($100k starting balance)
# Required for official P&L measurement window: Aug 31 9:30 AM to Sep 4 9:30 AM ET
ALPACA_COMPETITION_API_KEY=your_official_competition_key_here
ALPACA_COMPETITION_SECRET_KEY=your_official_competition_secret_here

# General Alpaca Endpoint Settings
ALPACA_PAPER=True
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ------------------------------------------------------------------------------
# 2. Automated Trading LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider to use during automated trading decisions: 'gemini' or 'featherless'
LLM_PROVIDER=gemini

# Google Gemini API Settings
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Featherless AI Settings (OpenAI-Compatible, Promo: ALPACA26)
# Options: 'Qwen/Qwen2.5-72B-Instruct', 'zai-org/GLM-5.2', 'meta-llama/Meta-Llama-3.1-70B-Instruct'
FEATHERLESS_API_KEY=fw-your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# ------------------------------------------------------------------------------
# 3. Deterministic Hard Risk Gate Boundaries (Aggressive Hackathon Tier)
# ------------------------------------------------------------------------------
INITIAL_CAPITAL=100000.0
MAX_RISK_PER_TRADE_PCT=0.05          # 5.0% ($5,000 max risk per position)
MAX_MARGIN_UTILIZATION_PCT=0.40      # 40.0% ($40,000 max portfolio margin)
DAILY_LOSS_CIRCUIT_BREAKER_PCT=0.05  # 5.0% ($5,000 daily loss -> halt new trades)
MAX_PORTFOLIO_DRAWDOWN_PCT=0.10      # 10.0% ($10,000 drawdown -> emergency halt)
TAKE_PROFIT_PCT=0.60                 # Automated 60% profit target
STOP_LOSS_MULTIPLIER=2.5             # Automated 2.5x credit received stop-loss

# ------------------------------------------------------------------------------
# 4. System Runtime & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
EVALUATION_INTERVAL_SECONDS=30
SCREENER_MIN_STOCK_PRICE=10.0
