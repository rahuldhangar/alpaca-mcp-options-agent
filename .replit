run = "streamlit run streamlit_app.py --server.port 8000 --server.address 0.0.0.0"
entrypoint = "streamlit_app.py"

[nix]
channel = "stable-23_11"

[deployment]
run = ["sh", "-c", "streamlit run streamlit_app.py --server.port 8000 --server.address 0.0.0.0"]

[[ports]]
localPort = 8000
externalPort = 80
